# Cortex-M3 reference platform: virtual PL SoC + systemc-soc baremetal firmware
PLATFORM_DIR=platforms/basic_cortexM
MODEL_DIR=peripherals/timer
QEMU_MACHINE=systemc-soc
QEMU_CPU=cortex-m3
SYSTEMC_PL_BASE=0x40000000
FIRMWARE_DIR=platforms/basic_cortexM/firmware
FIRMWARE_ELF=timer_fw.elf
QEMU_EXTRA_ARGS=""
QEMU_MONITOR_ARGS="-monitor none"
