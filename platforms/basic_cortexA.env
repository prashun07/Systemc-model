# Cortex-A9 reference platform: Timer demo + systemc-ps baremetal firmware
PLATFORM_DIR=platforms/basic_cortexA
MODEL_DIR=peripherals/timer
QEMU_MACHINE=systemc-ps
QEMU_CPU=cortex-a9
SYSTEMC_PL_BASE=0xF0000000
FIRMWARE_DIR=platforms/basic_cortexA/firmware
FIRMWARE_ELF=timer_ps.elf
QEMU_EXTRA_ARGS="-smp 1 -m 256M"
QEMU_MONITOR_ARGS="-monitor none"
