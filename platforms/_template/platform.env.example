# Example — copy to platforms/my_model_m3.env and edit paths.
PLATFORM_DIR=platforms/_template
MODEL_DIR=MyModel
QEMU_MACHINE=systemc-soc
QEMU_CPU=cortex-m3
SYSTEMC_PL_BASE=0x40000000
FIRMWARE_DIR=platforms/_template/firmware
FIRMWARE_ELF=my_model_fw.elf
QEMU_EXTRA_ARGS=""
QEMU_MONITOR_ARGS="-monitor none"
